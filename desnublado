dst="${DNBL_DST:-$base_path/Camera_mini}"
tmp="${DNBL_TMP:-${TMPDIR:-$HOME}}"
lock_file="${DNBL_LOCK_FILE:-$config_path/.desnublado.lock}"
lang_file="${DNBL_LANG_FILE:-$config_path/desnublado.lang}"
rebuild_flag="${DNBL_REBUILD_FLAG:-$base_path/desnublado.rebuild}"
db="${DNBL_DB:-$config_path/desnublado.db}"
min_free_mb="${DNBL_MIN_FREE_MB:-2048}" # target filesystem must have this free space to proceed (in megabytes)
ffmpeg_params=(-vf scale=640:640:force_original_aspect_ratio=decrease:force_divisible_by=2 -c:v libsvtav1 -crf 41 -preset 2 -c:a libopus -b:a 64k)
magick_params=(-resize @900000\>)
date_rename="${DNBL_DATE_RENAME:-true}"
do_scroll="${DNBL_DO_SCROLL:-false}"
move_sources="${DNBL_MOVE_SOURCES:-true}"
force_overwrite="${DNBL_FORCE_OVERWRITE:-false}"
show_full_path="${DNBL_SHOW_FULL_PATH:-false}"
allow_dupes="${DNBL_ALLOW_DUPES:-false}" # false implies using sqlite3 database
override_file="${DNBL_OVERRIDE_FILE:-$config_path/desnublado.override}"
ext_list="${DNBL_EXT_LIST:-mp4 mkv jpg avif}"
auto_update="${DNBL_AUTO_UPDATE:-false}"
prefer_meta="${DNBL_PREFER_META:-false}"
prefer_utc="${DNBL_PREFER_UTC:-false}"

# non configurable globals
hasher="xxh128sum"
source_hash=""
convert_return_code=0
sys_tz=""
allow_dynamic="false"
ext_params=()

