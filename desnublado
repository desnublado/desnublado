set -o nounset

if [ -d "$HOME/storage/shared/DCIM" ]; then
    # termux
    base_path="$HOME/storage/shared/DCIM"
elif [ -d "/mnt/shared/DCIM" ]; then
    # linux virtual machine
    base_path="/mnt/shared/DCIM"
else
    # generic
    command -v xdg-user-dir > /dev/null && base_path="$(xdg-user-dir PICTURES)" || base_path="$HOME/Pictures"
fi

config_path="$HOME/.config/desnublado"

src="${DNBL_SRC:-$base_path/Camera}"
src_done="${DNBL_SRC_DONE:-$base_path/Camera_done}"
src_extra="${DNBL_SRC_EXTRA:-$base_path/Camera_extra}"
src_extra_done="${DNBL_SRC_EXTRA_DONE:-}"
src_extra_dst="${DNBL_SRC_EXTRA_DST:-}"
